# Optional local static-site container. Not part of the Sites deployment workflow.
# Pin a base-image digest for strict image identity in your own environment.
FROM python:3.12.14-slim
WORKDIR /app
COPY dist/ ./dist/
EXPOSE 8000
CMD ["python", "-m", "http.server", "8000", "--directory", "dist", "--bind", "0.0.0.0"]
